        {
          "id": "a1-1-5",
          "type": "order",
          "prompt": "Traduisez : « Je vais bien. »",
          "words": [
            "I",
            "am",
            "fine"
          ],
          "answer": "I am fine",
          "explanation": "En anglais, le sujet précède le verbe : I + am + fine."
        }
      ]
    },
